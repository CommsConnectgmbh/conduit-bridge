# Conduit bridge configuration.
#
# The installer writes what it knows (ports, PAIR_PUBLIC_HOST, CLAUDE_BIN,
# DB_DIR, PAIR_APP_BASE, PAIR_OWNER_EMAIL) to .env.local in the bridge
# directory; everything else has a sane default. Uncomment only what you want to change. Never put API keys or other
# secrets here: the CLIs the bridge drives use their own sign-in.

# --- Network -----------------------------------------------------------------

# Local bind. MUST stay on loopback: the Cloudflare tunnel terminates TLS and
# forwards to 127.0.0.1. Binding to 0.0.0.0 would expose the bridge to the LAN.
# BRIDGE_HOST=127.0.0.1
# BRIDGE_PORT=8787

# Second loopback listener for the pairing page and pairing codes. It is never
# reachable through the tunnel (the tunnel only forwards to BRIDGE_PORT).
# PAIR_PORT=8788

# Public hostname of this bridge's tunnel (set by the installer). Devices pair
# end to end against it; without it pairing is refused.
# PAIR_PUBLIC_HOST=b-xxxxxxxxxx.tryconduit.de

# Optional: only accept requests whose Host header is in this comma-separated
# allowlist (DNS-rebinding protection). Empty skips the check.
# BRIDGE_ALLOWED_HOSTS=b-xxxxxxxxxx.tryconduit.de

# CORS: the app origin (CONDUIT_APP_BASE, default https://app.tryconduit.de) is
# always allowed. Add extra origins (local development) as a comma-separated
# allowlist; responses never use `*`.
# BRIDGE_ALLOWED_ORIGINS=http://localhost:3000
# CONDUIT_APP_BASE=https://app.tryconduit.de

# --- Engines -----------------------------------------------------------------

# Claude Code CLI and the directory sessions start in.
# CLAUDE_BIN=/Users/yourname/.local/bin/claude
# CLAUDE_CWD=/Users/yourname/code
# CLAUDE_MODEL=claude-opus-5

# Hard allowlist of roots that @-mention file search and the per-session
# working directory may touch. Colon-separated absolute paths. Scope this to
# concrete project roots, never your whole home directory. Secret files
# (.env*, *.pem, *.key, *.p8, id_rsa ...) are always excluded. Defaults to
# CLAUDE_CWD.
# FILE_SEARCH_ROOTS=/Users/yourname/code

# Other engines are detected automatically when their CLI is installed.
# CODEX_BIN=/opt/homebrew/bin/codex
# CODEX_MODEL=
# AGY_BIN=/opt/homebrew/bin/agy
# AGY_MODEL=gemini-3.1-pro-high
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=

# Watchdog: a running turn that emits no output for this long (ms) is ended
# with an error instead of hanging. Default 900000 (15 minutes).
# CONDUIT_TURN_STALL_MS=900000

# --- Local speech --------------------------------------------------------------

# Speech recognition and voice output run on this machine with open models,
# downloaded on request from the app. Nothing is sent to a cloud service.
# CONDUIT_MODELS_DIR=/Users/yourname/.conduit/models
# CONDUIT_SPEECH_RUNTIME_DIR=/Users/yourname/.conduit/speech-runtime

# --- Self-update ---------------------------------------------------------------

# The bridge pulls newer releases from CONDUIT_APP_BASE/bridge/v3/bridge.tar.gz
# while idle and restarts under launchd/systemd. Every release must carry a
# valid Ed25519 signature for the public key compiled into selfupdate.mjs;
# there is no switch to accept unsigned code (see RELEASE_SIGNING.md). Set to 0
# to pin the installed version, for example while developing.
# CONDUIT_SELFUPDATE=1
# CONDUIT_SELFUPDATE_INTERVAL_MS=21600000

# --- Alexa (optional) ----------------------------------------------------------

# Your own Alexa skill can talk to this bridge at https://<PAIR_PUBLIC_HOST>/alexa.
# Requests are only answered for this skill and this Alexa user.
# ALEXA_SKILL_ID=amzn1.ask.skill.xxxxxxxx
# ALEXA_USER_ID=amzn1.ask.account.xxxxxxxx
# CLAUDE_ALEXA_MODEL=haiku

# --- Storage -------------------------------------------------------------------

# DB_DIR=/Users/yourname/Library/conduit-bridge
# LOG_DIR=/Users/yourname/Library/Logs/conduit-bridge
